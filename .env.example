# Sentry Configuration
# Get your DSN from https://sentry.io/settings/projects/YOUR_PROJECT/keys/
NEXT_PUBLIC_SENTRY_DSN=your-dsn-here
SENTRY_DSN=your-dsn-here

# Sentry Organization and Project (for source maps upload)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Sentry Auth Token (for uploading source maps during build)
# Create one at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-auth-token-here
